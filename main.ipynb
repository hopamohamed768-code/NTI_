   ],
   "source": [
    "nums = map(float, input(\"Enter any num\").split())\n",
    "\n",
    "for num in nums:\n",
    "    if num < 50 and num > 0:\n",
    "        print(f\"{num} is cheap\")\n",
    "    elif num >= 50 and num <= 100:\n",
    "        print(f\"{num} is mid\")\n",
    "    elif num > 100:\n",
    "        print(f\"{num} is expensive\")"
   ]
  }
 ],
